# --- Configuración Telegram ---
TELEGRAM_TOKEN="tu_token_aqui"
TELEGRAM_CHAT_ID="tu_chat_id_aqui"

# --- Configuración MicroShift ---
KUBECONFIG_PATH="/home/usuario/.kube/config-microshift"

# --- Configuración de Nodo Edge (Agatha/Dashiell/Marvin) ---
NODE_IP="192.168.122.32"
SSH_KEY_PATH="../magrathea/labkey"

# --- Configuración Multivac (Ollama Local) ---
MULTIVAC_URL="http://localhost:11434/api/generate"
OLLAMA_MODEL="qwen2.5-coder:1.5b"

# --- Configuración SMTP (Alertas Nivel 2) ---
